# Dev-only image intermediates — never referenced by runtime code.
# Excluding them cuts ~200 MB from every deployment upload.
# (Verified: no app/admin file loads these paths; annotatedReference entries
# in datasets/overlays.js are tracing metadata with no runtime consumer.)
public/plotmap-assets/processed
public/plotmap-assets/*-annotated-reference.png
public/plotmap-assets/aerotropolis-easy-map-reference.png
public/plotmap-assets/aerotropolis-original.png

# Design handoffs, archives, tooling — not part of the served product.
_design
archive
tools
docs
supabase
.agents
